{
    "name": "vino-costero/app",
    "description": "Vino Costero Laravel application",
    "type": "project",
    "require": {
        "php": "^8.3",
        "laravel/framework": "^11.0",
        "laravel/tinker": "^2.9"
    },
    "autoload": {
        "classmap": ["database/seeders"],
        "psr-4": {
            "App\\": "app/",
            "Database\\Seeders\\": "database/seeders/",
            "Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Database\\Seeders\\": "database/seeders/",
            "Database\\Factories\\": "database/factories/",
            "Tests\\": "tests/"
        }
    },
    "config": {
        "platform": { "php": "8.3.0" },
        "sort-packages": true,
        "audit": {
            "block-insecure": false
        }
    }
}
